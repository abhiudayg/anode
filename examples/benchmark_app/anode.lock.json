{
  "schema_version": "1.0",
  "resources": {
    "db-order": {
      "kind": "postgres",
      "lifecycle": "stateful_retain",
      "auto_provision": true,
      "provenance": "services/order/main.go:40",
      "migrations": {
        "tool": "goose",
        "path": "migrations/order",
        "execution": "pre_traffic_job"
      }
    },
    "db-payment-db": {
      "kind": "postgres",
      "lifecycle": "stateful_retain",
      "auto_provision": false,
      "provenance": "services/payment/main.go:31"
    }
  },
  "services": {
    "order": {
      "name": "order",
      "entrypoint": "./services/order",
      "ingress": [
        {
          "protocol": "http",
          "port_env": "PORT",
          "routes": [
            "POST /v1/orders"
          ]
        }
      ],
      "bindings": [
        {
          "resource_ref": "db-order",
          "protocol": "postgres",
          "inject_env": "",
          "provenance": "services/order/main.go:40"
        }
      ],
      "secrets": [
        {
          "env_var": "STRIPE_SECRET_KEY",
          "provenance": "services/order/main.go:27"
        }
      ]
    },
    "payment": {
      "name": "payment",
      "entrypoint": "./services/payment",
      "ingress": [
        {
          "protocol": "http",
          "port_env": "PORT",
          "routes": [
            "POST /v1/charges"
          ]
        }
      ],
      "bindings": [
        {
          "resource_ref": "db-payment-db",
          "protocol": "postgres",
          "inject_env": "PAYMENT_DB_URL",
          "expanded_env": [
            "PAYMENT_DB_URL"
          ],
          "provenance": "services/payment/main.go:31"
        }
      ],
      "secrets": []
    }
  }
}